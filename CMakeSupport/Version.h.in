#ifndef __VERSION_H
#define __VERSION_H

#include <cstdint>

#ifdef QT_VERSION
    #include <QString>
    #include <QDateTime>
    #include <QCoreApplication>
    #include <QTimeZone>
    #include <QLocale>
    // #include <QDebug>
#else
    #include <string>
#endif

namespace NVersion
{
#ifdef QT_VERSION
    using TStringType = QString;

    #define TRANSLATE( str ) QObject::tr( str )

    inline bool isEmpty( const TStringType &value )
    {
        return value.isEmpty();
    }

    template< typename T >
    inline TStringType toString( T value )
    {
        return QString::number( value );
    }
#else
    using TStringType = std::string;
    #define TRANSLATE( str ) str

    inline bool isEmpty( const TStringType &value )
    {
        return value.empty();
    }

    template< typename T >
    TStringType toString( T value )
    {
        return std::to_string( value );
    }
#endif

    inline const int MAJOR_VERSION = @VERSION_FILE_MAJOR_VERSION@;
    inline const int MINOR_VERSION = @VERSION_FILE_MINOR_VERSION@;
    inline const TStringType PATCH_VERSION = "@VERSION_FILE_PATCH_VERSION@";   // string from git
    inline const uint16_t PATCH_VERSION_LOW = @VERSION_FILE_PATCH_VERSION_HIGH@;   // string from git
    inline const uint16_t PATCH_VERSION_HIGH = @VERSION_FILE_PATCH_VERSION_LOW@;   // string from git

    inline const bool MODIFIED = @VERSION_FILE_DIFF@;
    inline const TStringType APP_NAME = TRANSLATE( "@VERSION_FILE_APP_NAME@" );
    inline const TStringType VENDOR = TRANSLATE( "@VERSION_FILE_VENDOR@" );
    inline const TStringType HOMEPAGE = TRANSLATE( "@VERSION_FILE_HOMEPAGE@" );
    inline const TStringType PRODUCT_HOMEPAGE = TRANSLATE( "@VERSION_FILE_PRODUCT_HOMEPAGE@" );
    inline const TStringType EMAIL = TRANSLATE( "@VERSION_FILE_EMAIL@" );
    inline const TStringType COPYRIGHT = TRANSLATE( "@VERSION_FILE_COPYRIGHT@" );
    inline const TStringType BUILD_DATE_UTC = TStringType( "@VERSION_FILE_BUILD_DATE@" );
    inline const TStringType BUILD_TIME_UTC = TStringType( "@VERSION_FILE_BUILD_TIME@" );

#ifdef QT_VERSION
    inline QDateTime buildDateTime( bool localTime )
    {
        if ( isEmpty( BUILD_DATE_UTC ) || isEmpty( BUILD_TIME_UTC ) )
            return {};

        auto retVal = QDateTime::fromString( BUILD_DATE_UTC + " " + BUILD_TIME_UTC, "MM/dd/yyyy HH:mm:sst" );
        Q_ASSERT( retVal.isValid() );
        //qDebug() << retVal;
        retVal.setTimeZone( QTimeZone::Initialization::UTC );
        //qDebug() << retVal;
        if ( localTime )
        {
            retVal = retVal.toLocalTime();
        }
        //qDebug() << retVal;
           
        return retVal;
    }
#endif

    inline TStringType getVersionString()
    {
        auto retVal = toString( MAJOR_VERSION ) + ".";
#ifdef VERSION_FILE_FORCE_TWODIGITS_MINOR
        if ( MINOR_VERSION < 10 )
            retVal += '0';
#endif
        retVal += toString( MINOR_VERSION );
        retVal += "." + PATCH_VERSION;
        if ( MODIFIED )
            retVal += "*";
        return retVal;
    }
    
    inline TStringType getBuildDateString( bool localTime )
    {
        TStringType retVal;
        auto buildDateTime = NVersion::buildDateTime( localTime );
        if ( buildDateTime.isValid() )
        {
            auto dateFormat = QLocale().dateFormat();
            auto timeFormat = "hh:mm:ss";
            // "MM/dd/yyyy hh:mm:ss"
            retVal += "Build Date: " + buildDateTime.toString( dateFormat + " " + timeFormat );

            auto abbr = buildDateTime.timeZoneAbbreviation();
            if ( !abbr.isEmpty() )
            {
                auto tzString = abbr;
                if ( abbr.startsWith( TRANSLATE( "Pacific" ), Qt::CaseInsensitive ) 
                 || abbr.startsWith( TRANSLATE( "Mountain" ), Qt::CaseInsensitive ) 
                 || abbr.startsWith( TRANSLATE( "Central" ), Qt::CaseInsensitive ) 
                 || abbr.startsWith( TRANSLATE( "Eastern" ), Qt::CaseInsensitive ) )
                {
                    tzString = abbr.front().toUpper();
                    if ( buildDateTime.isDaylightTime() )
                        tzString += TRANSLATE( "DT" );
                    else
                        tzString += TRANSLATE( "ST" );
                }
                retVal += " " +  tzString;
            }
        }
        return retVal;
    }
    
    inline TStringType getVersionAndBuildString( bool localTime, bool full )
    {
        auto retVal = getVersionString();   
        auto dateString = getBuildDateString( localTime );
        if ( full )
        {
            if ( !isEmpty( dateString ) )
                retVal += " ";
            retVal += dateString;
        }
        return retVal;
    }

    inline TStringType getWindowTitle( bool verbose )
    {
        auto retVal = APP_NAME + " v" + getVersionAndBuildString( false, verbose ) ;
        if ( verbose )
            retVal += " - https://" + HOMEPAGE;
        return retVal;
    }

#ifdef QT_VERSION
    inline void setupApplication( QCoreApplication &appl, bool useProductHomepage )
    {
        appl.setApplicationName( APP_NAME );
        appl.setApplicationVersion( getVersionAndBuildString( false, true ) );
        appl.setOrganizationName( VENDOR );
        appl.setOrganizationDomain( useProductHomepage ? PRODUCT_HOMEPAGE : HOMEPAGE );
    }
#endif
}

#endif
